{
  "name": "rl-forge",
  "productName": "RL Forge",
  "version": "2.0.0",
  "description": "Client-side item swap utility for Rocket League",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.thedroid.rlforge",
    "productName": "RL Forge",
    "publish": null,
    "win": {
      "target": "portable",
      "icon": "../assets/icon.ico"
    },
    "extraResources": [
      {
        "from": "../api",
        "to": "api"
      },
      {
        "from": "../core",
        "to": "core"
      },
      {
        "from": "python",
        "to": "python"
      }
    ]
  }
}
